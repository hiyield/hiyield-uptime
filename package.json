{
  "name": "hiyield-uptime",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "npm run db:migrate && nuxt dev",
    "cf:dev": "nuxt build && npm run cf:migrate && wrangler dev --env staging",
    "db:migrate": "wrangler d1 migrations apply hiyield-uptime --local",
    "cf:migrate": "wrangler d1 migrations apply hiyield-uptime-staging --local --env staging",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@nuxt/ui": "4.8.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "nuxt": "4.4.6",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@nuxt/eslint": "^1.17.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.147.0"
  }
}
